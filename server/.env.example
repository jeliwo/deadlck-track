# copy this file to ".env" and fill it in (never commit .env)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/deadlock?retryWrites=true&w=majority
DEADLOCK_API=https://api.deadlock-api.com
JWT_SECRET=change-me-to-a-long-random-string
CACHE_SECONDS=600
SNAPSHOT_MAX_AGE_SECONDS=3600
# comma-separated list of frontend origins allowed to call this API (leave empty = allow all, fine for local dev)
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
PORT=3000
